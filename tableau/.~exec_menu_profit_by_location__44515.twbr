      <column caption='Total Location Revenue' datatype='real' name='[Calculation_3059101538553865]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_per_item])' />
      </column>
      <column caption='Total Items Sold (Volume)' datatype='integer' name='[Calculation_3059101543481354]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([qty])' />
      </column>
      <column caption='Location Gross Profit ($)' datatype='real' name='[Calculation_3059101543804940]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_per_item]) - (SUM([qty]) * AVG([cost_per_serving]))' />
      </column>
      <column caption='Aggregate Profit Margin (%)' datatype='real' name='[Calculation_3059101543878669]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3059101543804940] / SUM([total_per_item])' />
      </column>
